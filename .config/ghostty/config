theme = tokyonight
font-family = JetBrains Mono
font-size = 16
font-variation = wght=600

window-padding-balance = true
copy-on-select = clipboard
adjust-cursor-thickness = 3
quit-after-last-window-closed = true

macos-titlebar-style = hidden

keybind = super+j=scroll_page_lines:1
keybind = super+k=scroll_page_lines:-1

keybind = super+u=scroll_page_up
keybind = super+d=scroll_page_down

keybind = ctrl+tab=text:\x1b[27;5;9~
keybind = ctrl+shift+tab=text:\x1b[27;6;9~

keybind = cmd+digit_1=text:\x1b[49;9u
keybind = cmd+digit_2=text:\x1b[50;9u
keybind = cmd+digit_3=text:\x1b[51;9u
keybind = cmd+digit_4=text:\x1b[52;9u
keybind = cmd+digit_5=text:\x1b[53;9u
keybind = cmd+digit_6=text:\x1b[54;9u
keybind = cmd+digit_7=text:\x1b[55;9u
keybind = cmd+digit_8=text:\x1b[56;9u
keybind = cmd+digit_9=text:\x1b[57;9u

keybind = cmd+t=unbind

custom-shader-animation = always
custom-shader = shaders/cursor_warp.glsl
